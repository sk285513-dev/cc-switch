                          {systemStatus.scraper.message || "尚無背景執行訊息。"}
                        </div>
                      </div>

                      {systemStatus.scraper.last_update && (
                        <div className="text-[10px] text-slate-500 text-right">
                          最後更新：{systemStatus.scraper.last_update}
