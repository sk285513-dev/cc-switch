                      >
                        {isDrafting ? <RefreshCw className="w-4 h-4 animate-spin text-white" /> : "\xe2\x9c\x8d儭\x8f 自動起草司法合格書狀"}
                      </button>
                    </div>
                  </div>
                </div>

