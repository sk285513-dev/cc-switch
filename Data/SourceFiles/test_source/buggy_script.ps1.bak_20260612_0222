$service = New-Object GoogleCloudNaturalLanguageAPIBetaClient

# 确保获取到正确的嵌入向量大小
$embeddings = $service->GetEmbedding("您的文本内容", 768)

if ($embeddings == null)
{
    write-host "无法获取文本的嵌入向量。"
}

elseif ($embeddings-dimension -ne 768)
{
    write-host "错误：预期的嵌入向量大小为768，实际获得的是${$embeddings.Dimension}."
}

else
{
    write-host "成功获取到文本的嵌入向量。"
}