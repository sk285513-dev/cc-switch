{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LexMind-Omni: 執行本地驗收與品質測試 (Run Verification)",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/auto_verify.py"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "LexMind-Omni: 啟動 30 堂大課自動排程佇列 (Start Scheduler)",
      "type": "shell",
      "command": "python",
      "args": [
        "A:/run_scheduled_batch.py"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
