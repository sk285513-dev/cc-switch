                run_single_task_safe,
                manifest,
                manifest_path,
                None,   # ??銝???key嚗orker ?芾?????
                qm,
                chunking_only,
            )
            futures[fut] = manifest["task_id"]

        for future in as_completed(futures):
            task_id = futures[future]
            try:
                success = future.result()
                status = "success" if success else "failed"
                log_workflow(f"[Parallel Dispatcher] Task {task_id} 摰?嚗???{status}")
            except Exception as e:
                log_error(f"[Parallel Dispatcher] Task {task_id} Future ?啣虜嚗e}")

    # ?交頛芷??擗遙??鈭斤 run_loop 銝?頛芾翮隞????銝?餈湛??踹??ㄖ嚗?
    remaining = len(active_tasks) - len(batch)
    if remaining > 0:
