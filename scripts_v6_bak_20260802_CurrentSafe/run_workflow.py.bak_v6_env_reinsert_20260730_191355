    manifest_paths = Path(manifests_dir).glob("*.json")
    active_tasks = []
    
    for p in manifest_paths:
        if not p.name.startswith("task_") or p.name.endswith("_chunks.json"):
            continue
        try:
            with open(p, "r", encoding="utf-8-sig") as f:
