    except Exception as e:
        log_error(f"Workflow Engine: Critical error in task {task_id}: {e}")
        try:
            with open(manifest_path, "r", encoding="utf-8-sig") as f:
                current_manifest = json.load(f)
            # ??靽風嚗 stt_runner 撌脣?隞餃??蔭??chunked嚗?敺?閰佗?嚗?閬?撖怎 failed
            if current_manifest.get("status") != "chunked":
                current_manifest["status"] = "failed"
                current_manifest["error"] = str(e)
                atomic_json_dump(current_manifest, manifest_path)
            else:
                log_workflow(f"Workflow Engine: Task {task_id} already reset to chunked by stt_runner, skipping failed overwrite.")
        except Exception as write_err:
            log_error(f"Failed to mark task as failed: {write_err}")
        return False


def run_loop(chunking_only=False):
    log_workflow("?箇瘜????瑕蔣?喳????極雿?????撌脣???" + (" [???芋撘" if chunking_only else ""))
    ensure_dirs()

    while True:
        try:
            # 1. ???唳?獢?
            scan_new_files()
            # 2. ?瑁?瘣餃?銝凋遙??STT 摰?敺?Worker 蝡?嚗erge/fmt ??Daemon ?交?嚗?
            process_active_tasks(chunking_only)
        except RuntimeError as e:
            # ?瘙皛????key ??429嚗? 蝑?餅?蝯?
            if "exhausted" in str(e).lower() or "皝? in str(e) or "all api keys" in str(e).lower():
                log_workflow(f"[Quota Cooldown] ?瘙嚗脣 600 蝘?餌??.. ({e})")
                time.sleep(600)
                # ?蔭 key pool state
